<%- include('partials/head', { title: 'Rooms' }) %>
<div class="card">
  <form class="toolbar" method="get" action="/rooms">
    <div>
      <label for="hostel">Hostel</label>
      <select id="hostel" name="hostel">
        <option value="">All hostels</option>
        <% hostels.forEach(function (h) { %>
          <option value="<%= h.hostel_id %>" <%= hostelId === h.hostel_id ? 'selected' : '' %>><%= h.hostel_name %></option>
        <% }); %>
      </select>
    </div>
    <button class="btn btn-ghost" type="submit">Show</button>
    <div class="grow">
      <label for="live">Filter this list</label>
      <input id="live" type="search" data-filter="rooms-table" placeholder="Type to filter the rows below">
    </div>
    <a class="btn btn-primary" href="/rooms/new<%= hostelId ? '?hostel=' + hostelId : '' %>">Add room</a>
  </form>

  <% if (rooms.length === 0) { %>
    <div class="empty-state"><%- icon('rooms') %><p>No rooms found.</p></div>
  <% } else { %>
  <div class="table-wrap">
    <table id="rooms-table" class="table-stack">
      <thead><tr><th>Hostel</th><th>Room</th><th>Floor</th><th>Type</th><th>Beds used</th><th>Free</th><th>Fee / term</th><th></th></tr></thead>
      <tbody>
        <% rooms.forEach(function (r) { %>
          <tr>
            <td data-label="Hostel"><%= r.hostel_name %></td>
            <td data-label="Room"><%= r.room_number %></td>
            <td data-label="Floor"><%= r.floor %></td>
            <td data-label="Type"><%= roomType(r.capacity) %></td>
            <td data-label="Beds used"><%= r.occupied %> / <%= r.capacity %></td>
            <td data-label="Free"><%= r.vacancies %></td>
            <td data-label="Fee / term"><%= money(r.fee_per_term) %></td>
            <td data-label="Actions">
              <div class="actions">
                <a class="btn btn-sm btn-ghost" href="/rooms/<%= r.room_id %>/edit">Edit</a>
                <form method="post" action="/rooms/<%= r.room_id %>/delete" data-confirm="Delete room <%= r.room_number %> of <%= r.hostel_name %>?">
                  <button class="btn btn-sm btn-danger" type="submit">Delete</button>
                </form>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <% } %>
</div>
<%- include('partials/foot') %>