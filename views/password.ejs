<%- include('partials/head', { title: 'Change password' }) %>
<div class="card form-card">
  <h2>Change your password</h2>
  <form method="post" action="/account/password">
    <div class="form-group">
      <label for="current_password">Current password</label>
      <input id="current_password" name="current_password" type="password" required autocomplete="current-password">
    </div>
    <div class="form-group">
      <label for="new_password">New password</label>
      <input id="new_password" name="new_password" type="password" required minlength="6" autocomplete="new-password">
      <div class="hint">Minimum 6 characters.</div>
    </div>
    <div class="form-group">
      <label for="confirm_password">Confirm new password</label>
      <input id="confirm_password" name="confirm_password" type="password" required minlength="6"
             data-match="#new_password" autocomplete="new-password">
      <div class="hint">Type the new password again.</div>
    </div>
    <button class="btn btn-primary" type="submit">Save password</button>
  </form>
</div>
<%- include('partials/foot') %>
